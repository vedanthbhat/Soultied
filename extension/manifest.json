{
  "manifest_version": 3,
  "name": "Soultied: Watch Party for Netflix, Prime, Hotstar, Disney+, Crunchyroll",
  "short_name": "Soultied",
  "version": "1.7.1",
  "description": "Watch Netflix, Prime Video, JioHotstar, Disney+, Crunchyroll and more in sync with your person: send a link, chat on a pixel couch.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Soultied: watch together",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "permissions": [
    "storage",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://*.primevideo.com/*",
    "https://www.amazon.com/gp/video/*",
    "https://www.amazon.in/gp/video/*",
    "https://www.amazon.co.uk/gp/video/*",
    "https://www.amazon.de/gp/video/*",
    "https://www.amazon.ca/gp/video/*",
    "https://www.amazon.com.au/gp/video/*",
    "https://www.amazon.co.jp/gp/video/*",
    "https://www.amazon.fr/gp/video/*",
    "https://www.amazon.it/gp/video/*",
    "https://www.amazon.es/gp/video/*",
    "https://www.hotstar.com/*",
    "https://www.sonyliv.com/*",
    "https://www.zee5.com/*",
    "https://www.disneyplus.com/*",
    "https://www.hulu.com/*",
    "https://play.hbomax.com/*",
    "https://play.max.com/*",
    "https://www.crunchyroll.com/*",
    "https://static.crunchyroll.com/vilos-v2/*",
    "https://soultied.app/*",
    "https://www.soultied.app/*",
    "https://soultied-c1543.web.app/*",
    "https://soultied-c1543.firebaseapp.com/*",
    "https://*.run.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://*.primevideo.com/*",
        "https://www.amazon.com/gp/video/*",
        "https://www.amazon.in/gp/video/*",
        "https://www.amazon.co.uk/gp/video/*",
        "https://www.amazon.de/gp/video/*",
        "https://www.amazon.ca/gp/video/*",
        "https://www.amazon.com.au/gp/video/*",
        "https://www.amazon.co.jp/gp/video/*",
        "https://www.amazon.fr/gp/video/*",
        "https://www.amazon.it/gp/video/*",
        "https://www.amazon.es/gp/video/*",
        "https://www.hotstar.com/*",
        "https://www.sonyliv.com/*",
        "https://www.zee5.com/*",
        "https://www.disneyplus.com/*",
        "https://www.hulu.com/*",
        "https://play.hbomax.com/*",
        "https://play.max.com/*",
        "https://www.crunchyroll.com/*"
      ],
      "js": [
        "player.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://static.crunchyroll.com/vilos-v2/*"
      ],
      "js": [
        "player.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "netflix-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.primevideo.com/*",
        "https://www.amazon.com/gp/video/*",
        "https://www.amazon.in/gp/video/*",
        "https://www.amazon.co.uk/gp/video/*",
        "https://www.amazon.de/gp/video/*",
        "https://www.amazon.ca/gp/video/*",
        "https://www.amazon.com.au/gp/video/*",
        "https://www.amazon.co.jp/gp/video/*",
        "https://www.amazon.fr/gp/video/*",
        "https://www.amazon.it/gp/video/*",
        "https://www.amazon.es/gp/video/*"
      ],
      "js": [
        "prime-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://soultied.app/*",
        "https://www.soultied.app/*",
        "https://soultied-c1543.web.app/*",
        "https://soultied-c1543.firebaseapp.com/*",
        "https://*.run.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*"
      ],
      "matches": [
        "https://www.netflix.com/*",
        "https://*.primevideo.com/*",
        "https://www.amazon.com/*",
        "https://www.amazon.in/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.de/*",
        "https://www.amazon.ca/*",
        "https://www.amazon.com.au/*",
        "https://www.amazon.co.jp/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.it/*",
        "https://www.amazon.es/*",
        "https://www.hotstar.com/*",
        "https://www.sonyliv.com/*",
        "https://www.zee5.com/*",
        "https://www.disneyplus.com/*",
        "https://www.hulu.com/*",
        "https://play.hbomax.com/*",
        "https://play.max.com/*",
        "https://www.crunchyroll.com/*",
        "https://static.crunchyroll.com/*"
      ]
    }
  ]
}
