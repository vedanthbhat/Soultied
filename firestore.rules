rules_version = '2';

// Soultied: only the two people in a place can see or change anything in it.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return request.auth.uid;
    }
    function spacePath(sid) {
      return /databases/$(database)/documents/spaces/$(sid);
    }
    function isMember(sid) {
      return signedIn() && me() in get(spacePath(sid)).data.members;
    }
    // for writes batched together with creating the place
    function isMemberAfter(sid) {
      return signedIn() && me() in getAfter(spacePath(sid)).data.members;
    }

    // An invite code points at a place. Anyone signed in who has the code can
    // read it (to see whose invite it is); nobody can list them.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if request.resource.data.spaceId is string
        && isMemberAfter(request.resource.data.spaceId);
      // only the place a code already belongs to can touch it again
      allow update: if isMember(resource.data.spaceId)
        && request.resource.data.spaceId == resource.data.spaceId;
      allow delete: if false;
    }

    match /spaces/{sid} {
      allow get, list: if signedIn() && me() in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.creatorId == me()
        && request.resource.data.members == [me()]
        && request.resource.data.id == sid;

      allow update: if signedIn() && (
        // either of you can rename the place, set your anniversary, refresh the invite
        (me() in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'togetherSince', 'partnerPlaceholderName', 'inviteCode', 'inviteExpiresAt', 'inviteExpiresAtMs', 'timezone']))
        ||
        // taking the empty seat with a valid, unexpired invite code
        (!(me() in resource.data.members)
          && resource.data.get('partnerId', null) == null
          && resource.data.members.size() == 1
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['partnerId', 'members', 'joinCode', 'partnerPlaceholderName'])
          && request.resource.data.partnerId == me()
          && request.resource.data.members == resource.data.members.concat([me()])
          && request.resource.data.joinCode == resource.data.inviteCode
          && request.time.toMillis() < resource.data.inviteExpiresAtMs)
      );

      allow delete: if false;

      // each person's name and look: readable by both, written only by its owner
      match /members/{uid} {
        allow read: if isMember(sid);
        allow create, update: if uid == me() && isMemberAfter(sid);
        allow delete: if false;
      }

      // one letter day; you can only ever write your own answers
      match /letters/{day} {
        allow read: if isMember(sid);
        allow create: if isMember(sid)
          && request.resource.data.get('by', {}).keys().hasOnly([me()]);
        allow update: if isMember(sid)
          && request.resource.data.get('by', {}).diff(resource.data.get('by', {})).affectedKeys().hasOnly([me()])
          && request.resource.data.cardIds == resource.data.cardIds;
        allow delete: if false;
      }

      match /meta/{doc} {
        allow read, create, update: if isMember(sid);
        allow delete: if false;
      }

      match /activities/{id} {
        allow read: if isMember(sid);
        allow create: if isMemberAfter(sid);
        allow update, delete: if false;
      }

      // short-lived messages: play/pause, chat, call set-up, escape rooms
      match /live/{topic}/events/{id} {
        allow read: if isMember(sid);
        allow create: if isMember(sid) && request.resource.data.by == me();
        allow delete: if isMember(sid);
        allow update: if false;
      }
    }

    // A watch party from the browser extension: two people, no Soultied place
    // needed (each is signed in anonymously by the extension). Whoever has the
    // link can see who started it and take the one empty seat; only the two
    // people in it can send or see play/pause and chat.
    match /parties/{pid} {
      function partyMember() {
        return signedIn() && me() in get(/databases/$(database)/documents/parties/$(pid)).data.members;
      }
      function personOk(p) {
        return p is map && p.keys().hasOnly(['name', 'avatar'])
          && p.name is string && p.name.size() > 0 && p.name.size() <= 40
          && p.avatar is map;
      }
      function mineOk() {
        return me() in request.resource.data.people && personOk(request.resource.data.people[me()]);
      }

      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.id == pid
        && request.resource.data.host == me()
        && request.resource.data.members == [me()]
        && request.resource.data.people.keys().hasOnly([me()])
        && mineOk();

      // Soultied Plus for the party: a code you've added (it's real, still valid, and yours), with its end date
      function plusCodeAt(code) {
        return get(/databases/$(database)/documents/plusCodes/$(code)).data;
      }
      function plusOk() {
        let p = request.resource.data.get('plus', null);
        return p == null
          || (p is map
            && p.keys().hasOnly(['by', 'code', 'until'])
            && p.by == me()
            && p.code is string
            && exists(/databases/$(database)/documents/plusCodes/$(p.code))
            && me() in plusCodeAt(p.code).activations
            && p.until == plusCodeAt(p.code).validUntil
            && request.time < p.until);
      }

      allow update: if signedIn()
        && request.resource.data.id == resource.data.id
        && request.resource.data.host == resource.data.host
        && request.resource.data.people.diff(resource.data.people).affectedKeys().hasOnly([me()])
        && mineOk()
        && (
          // in the party: what's on, your own name and look, and Plus
          (me() in resource.data.members
            && request.resource.data.members == resource.data.members
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'people', 'updatedAt', 'plus'])
            && (!('plus' in request.resource.data.diff(resource.data).affectedKeys()) || plusOk()))
          ||
          // taking the second seat
          (!(me() in resource.data.members)
            && resource.data.members.size() == 1
            && request.resource.data.members == resource.data.members.concat([me()])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'people', 'updatedAt']))
        );

      allow delete: if false;

      // play/pause, chat and reactions between the two of you (and setting up the call, with Plus)
      match /events/{id} {
        allow read: if partyMember();
        allow create: if partyMember() && request.resource.data.by == me();
        allow update, delete: if false;
      }
    }

    // Soultied Plus codes, made by Soultied's server when a payment goes through (the id is the
    // code's SHA-256, so the list never holds a code you could read off it). Whoever has a code can
    // look it up and add their browser to it (up to three) while it's valid. Nobody can list them.
    match /plusCodes/{hash} {
      allow get: if signedIn();
      allow list, create, delete: if false;
      allow update: if signedIn()
        && request.time < resource.data.validUntil
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activations'])
        && !(me() in resource.data.activations)
        && request.resource.data.activations == resource.data.activations.concat([me()])
        && request.resource.data.activations.size() <= 3;
    }

    // the server's own record of each paid order (only the server touches it)
    match /plusOrders/{id} {
      allow read, write: if false;
    }
  }
}
